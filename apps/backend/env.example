# Copy this file to ".env" in this same folder (apps/backend/.env) and fill
# in the keys for whichever AI provider(s) you want to use. The app falls
# back to a deterministic, data-grounded assistant for any provider that
# isn't configured, so you only need to fill in the one you plan to use.

# Which provider the backend uses if the frontend doesn't specify one.
# One of: openai, gemini, claude, ollama
NETVISION_DEFAULT_AI_PROVIDER=ollama

# --- OpenAI ---
NETVISION_OPENAI_API_KEY=
NETVISION_OPENAI_MODEL=gpt-4o-mini

# --- Google Gemini ---
NETVISION_GEMINI_API_KEY=
NETVISION_GEMINI_MODEL=gemini-1.5-flash

# --- Anthropic Claude ---
NETVISION_ANTHROPIC_API_KEY=
NETVISION_ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Ollama (local, no API key needed) ---
# Make sure Ollama is installed and running (ollama serve) and that the
# model below has been pulled (ollama pull llama3.1).
NETVISION_OLLAMA_BASE_URL=http://127.0.0.1:11434
NETVISION_OLLAMA_MODEL=llama3.2

# How long to wait for a provider response before falling back (seconds)
NETVISION_AI_REQUEST_TIMEOUT_SECONDS=20
